# SlotKart Python FastAPI Slot Engine - Environment Variables
PORT=8000

# MongoDB connection string (same Atlas/local cluster as Express server)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=slotkart

# Shared secret header (X-Internal-Key) - MUST match server/.env INTERNAL_API_KEY
INTERNAL_API_KEY=slotkart_internal_secret_key_change_in_prod_2026

# Slot defaults
DEFAULT_SLOT_CAPACITY=5
SEED_PINCODES=302001,302017,324001
TZ=Asia/Kolkata

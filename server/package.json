{
  "name": "slotkart-server",
  "version": "1.0.0",
  "description": "SlotKart Express + Mongoose backend with Smart Delivery Slot Engine integration",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "build": "npm --prefix ../client install && npm --prefix ../client run build"
  },
  "dependencies": {
    "axios": "1.7.9",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-validator": "7.2.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "morgan": "1.10.0"
  },
  "devDependencies": {
    "nodemon": "3.1.9"
  }
}

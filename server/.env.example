# SlotKart Express Backend - Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB connection string (must include database name /slotkart matching MONGO_DB_NAME)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/slotkart?retryWrites=true&w=majority

# JWT Authentication (use a strong 64-char random string in production)
JWT_SECRET=slotkart_jwt_super_secret_key_change_in_prod_2026_64chars
JWT_EXPIRES_IN=7d

# Frontend origin for strict CORS
CLIENT_URL=http://localhost:5173

# Python FastAPI Smart Delivery Slot Engine
SLOT_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=slotkart_internal_secret_key_change_in_prod_2026
